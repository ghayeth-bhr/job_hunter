# ─────────────────────────────────────────────────────────
#  EU Job Hunter — Environment Config (OpenRouter Edition)
# ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ── Required ──────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SERPER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx    # free 2,500 one-time queries at https://serper.dev
                                                              # (query volume was cut way down — see search_eu_job_opportunities
                                                              #  in main.py — so this free allotment lasts months, not days)

# ── Free structured job APIs (tools/job_apis.py) ──────────
# Arbeitnow / Remotive / RemoteOK / Jobicy / Bundesagentur need NO key at all.
# Adzuna is free tier (~1,000 calls/month) — sign up at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ── Paid Apify sources (tools/job_apis.py) — OFF BY DEFAULT ──
# LinkedIn/WTTJ/Indeed via Apify actors. These cost real money (confirmed
# 2026-08-17: ~$0.002/result LinkedIn, ~$0.003/result WTTJ, ~$0.00017/result
# Indeed) against Apify's $5/month free credit, which has a HARD cap — no
# overage without upgrading off the Free plan. Sign up at https://apify.com
# and get a token from the Console → Integrations page.
ENABLE_APIFY=false
APIFY_API_TOKEN=
# Fixed top-3 by AI/ML/CV job volume, not narrowed to French-speaking
# markets — override via comma-separated country names if you want a
# different scope (2-3 recommended to keep cost bounded).
APIFY_LINKEDIN_COUNTRIES=Germany,France,Canada
# WTTJ is inherently France/Francophone-focused as a platform — this is
# not a candidate-targeting choice.
APIFY_WTTJ_COUNTRIES=France

# ── Cross-run persistence (tools/store.py) ────────────────
# SQLite file tracking which postings were already reported, so daily runs
# only surface NEW opportunities instead of re-sending yesterday's list.
SEEN_JOBS_DB=./data/seen_jobs.db

# ── Model (any OpenRouter slug) ───────────────────────────
# Default is a free model — 2 LLM calls/day is trivially inside OpenRouter's
# 50 free-requests/day cap (no purchased credits needed). main.py's _llm()
# automatically falls back through FREE_MODEL_FALLBACKS if MODEL 4xxs or is
# pulled from the free tier. This ALREADY happened once (2026-08-16):
# openai/gpt-oss-120b:free was pulled from the free tier entirely — the
# free roster rotates on its own schedule, re-check
# https://openrouter.ai/models?max_price=0 if these slugs stop working:
#   openai/gpt-oss-20b:free           (default)
#   nvidia/nemotron-3-nano-30b-a3b:free
#   google/gemma-4-31b-it:free
#   nvidia/nemotron-3-ultra-550b-a55b:free
# Paid alternatives (only needed if you want higher quality than free tier):
#   openai/gpt-4o-mini  (~$0.15/run, consistently valid JSON)
#   anthropic/claude-3.5-haiku        (fast + smart)
MODEL=openai/gpt-oss-20b:free

# ── Optional ──────────────────────────────────────────────
EU_LOCATIONS=France,Germany,Netherlands,Spain,Portugal,Poland,Czech Republic,Sweden,Switzerland,Belgium,Canada
OUTPUT_DIR=./reports

# ── Crawl4AI ──────────────────────────────────────────────
CRAWL4AI_MAX_CONCURRENT=10          # Parallel browser tabs
CRAWL4AI_CACHE_DIR=./.crawl_cache   # Crawl4AI disk cache
COMPANY_ENRICH_MAX=20               # Max companies to enrich per run
ENABLE_DIRECT_CRAWL=true            # Set false to skip direct board crawling
DIRECT_CRAWL_MAX_PER_BOARD=15       # Pages per direct board

# ── Email (SendGrid) ──────────────────────────────────────
# Required only if ENABLE_EMAIL=true
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=you@example.com
SENDGRID_TO_EMAIL=you@example.com
ENABLE_EMAIL=false                  # Set true to send report via email after each run

# ── Telegram bot (run_telegram_bot.py, tools/telegram_bot.py) ─────
# On-demand trigger + delivery, no scheduled cron. Message your bot
# /search to run a search, /status to check if one's in progress.
# Get a token from @BotFather; get your chat_id by messaging your bot
# once, then checking https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# CV this bot runs searches against (fixed -- Telegram isn't uploading a
# fresh one each time). Bot refuses to start if this is unset/missing.
TELEGRAM_CV_PATH=
